+/** Arma (o rehace) el lienzo del proyecto. `people` = personas de la organización (para compromisos). */
+export function buildCanvas(people: { name: string; email?: string; id?: string }[], raw?: unknown) {
+  const board: Board = readBoard(raw, PROJECT);
+  board.items = board.items.filter((i) => !i.id.startsWith('esf_'));
+  board.connectors = board.connectors.filter((c) => !c.id.startsWith('esf_'));
+  const rest = board.items;
+  const y0 = rest.length ? Math.min(...rest.map((i) => i.y)) - topSection(0, 0).height - 160 : 0;
+  const x0 = rest.length ? Math.min(...rest.map((i) => i.x)) : 0;
+  const top = topSection(x0, y0);
+  board.items.push(...top.items);
+  board.connectors.push(...top.connectors);
+
+  const { errors, done } = applySpec(board, { processes: PROCESSES }, people);
+  if (errors.length) throw new Error(`No se armó el lienzo:\n- ${errors.join('\n- ')}`);
+
+  // Historias, vistas y reportes; dependencias dibujadas entre procesos
+  const byName = (n: string) => Object.values(board.processes).find((p) => p.name === n)!;
+  const roleId = (n: string) => board.roles.find((r) => r.name === n)?.id;
+  const itemOf = (pid: string) => board.items.find((i) => i.kind === 'process' && i.processId === pid)!;
+  for (const sp of PROCESSES) {
+    const p = byName(sp.name) as Board['processes'][string] & { story?: unknown };
+    const s = STORIES[sp.name];
+    p.story = { phase: s.phase, phaseHint: s.phaseHint, como: s.como, quiero: s.quiero, para: s.para, module: s.module, org: 'Expo Santa Fe', criteria: s.criteria,
+      depends: (s.depends ?? []).map((n) => byName(n).id), authorizedBy: AUTH, notes: s.notes ?? [], doc: 'https://drive.google.com/file/d/14qFtupXkWm03CsUR6mYtzxxBH_gAPJ7L/view' };
+    p.startDate = '2027-01-11';
+    p.views = (VIEWS[sp.name] ?? []).map((v, i) => ({ id: `esf_v${i}_${p.id}`, name: v.name, roleIds: v.roles.map(roleId).filter(Boolean), columns: v.columns, ...(v.filter ? { filter: v.filter } : {}), ...(v.groupBy ? { groupBy: v.groupBy } : {}) }));
+    p.reports = (REPORTS[sp.name] ?? []).map((r, i) => ({ id: `esf_r${i}_${p.id}`, name: r.name, metric: r.metric, roleIds: r.roles.map(roleId).filter(Boolean), frequency: r.frequency, ...(r.chart ? { chart: r.chart } : {}) }));
+    for (const dep of s.depends ?? []) board.connectors.push({ id: `esf_d_${byName(dep).id}_${p.id}`, from: itemOf(byName(dep).id).id, to: itemOf(p.id).id, label: 'habilita', dashed: true });
+    Object.assign(itemOf(p.id), processSize(p));
+  }
+  return { board, done };
+}

+/**
+ * Organización Expo Santa Fe en The Office (implementación de IventIA):
+ * 1. Crea la organización «Expo Santa Fe» (slug expo-santa-fe) con sus roles.
+ * 2. Da de alta a quien la crea (LAB_EMAIL) como administrador, ligado a su cuenta (cambia de organización sin volver a entrar).
+ * 3. Crea en el Laboratorio el proyecto «Integración IventIA ↔ SAE: facturación automática» con su ficha, el lienzo
+ *    (ecosistema, objetos espejo, procesos con historia de usuario, decisiones abiertas y riesgos) y la agenda de
+ *    sesiones de integración (LabBoard.workplan). Los datos viven en scripts/data/expo-santa-fe.ts.
+ * Idempotente: lo que ya existe no se duplica; los procesos con el mismo nombre se rehacen en su lugar; la agenda sólo
+ * se pone si el proyecto no tiene (FORCE=1 la reemplaza).
+ *
+ * Uso: DATABASE_URL=… LAB_EMAIL=correo@… [FORCE=1] npx tsx scripts/expo-santa-fe-organizacion.ts
+ *      DRY_RUN=1 npx tsx scripts/expo-santa-fe-organizacion.ts   → sólo arma el lienzo y escribe expo-santa-fe.lab.json (sin base)
+ */
+import fs from 'node:fs';
+import path from 'node:path';
+import { buildCanvas, buildWorkplan, PROJECT, SLUG, TENANT, FICHA } from './data/expo-santa-fe';
+
+async function dryRun() {
+  const { board, done } = buildCanvas([]);
+  const out = path.join(process.cwd(), 'expo-santa-fe.lab.json');
+  fs.writeFileSync(out, JSON.stringify(board, null, 2));
+  const wp = buildWorkplan('Consumatum');
+  console.log(`Lienzo: ${done.join('; ')}.`);
+  console.log(`Agenda: ${wp.sessions.length} sesiones, ${wp.roles.length} responsabilidades, ${wp.inputs.length} insumos.`);
+  console.log(`Escribí ${out}`);
+}
+
+async function main() {
+  const { prisma, Prisma } = await import('@theoffice/db');
+  const { nextCode } = await import('../src/services/codes');
+  const { logActivity } = await import('../src/services/activity');
+  const { summarize } = await import('../src/services/labProject');
+  const { accountOf } = await import('../src/services/orgs');
+  const { orgPeople } = await import('../src/services/labCanvas');
+  try {
+    const email = (process.env.LAB_EMAIL ?? '').trim().toLowerCase();
+    if (!email) throw new Error('Falta LAB_EMAIL.');
+    const col = await prisma.$queryRaw<{ n: bigint }[]>`SELECT count(*)::bigint AS n FROM information_schema.columns WHERE table_name = 'LabBoard' AND column_name = 'workplan'`;
+    if (!Number(col[0]?.n)) throw new Error('La base todavía no tiene la columna LabBoard.workplan: espera el deploy del API.');
+
+    // 1. Organización y roles
+    let tenant = await prisma.tenant.findUnique({ where: { slug: SLUG } });
+    if (!tenant) {
+      tenant = await prisma.tenant.create({ data: { slug: SLUG, ...TENANT } });
+      console.log(`Organización creada: ${tenant.name} (${SLUG}).`);
+    } else console.log(`Organización ya existía: ${tenant.name}.`);
+    const tid = tenant.id;
+    const role = async (name: string, data: Partial<import('@theoffice/db').Prisma.RoleUncheckedCreateInput>) =>
+      prisma.role.upsert({ where: { tenantId_name: { tenantId: tid, name } }, update: {}, create: { tenantId: tid, name, ...data } });
+    const admin = await role('Administrador', { description: 'Acceso total', isAdmin: true, modules: ['A', 'B', 'C', 'D', 'E', 'CONFIG'] });
+    await role('Contabilidad y finanzas', { description: 'Colabora en el proyecto de integración IventIA ↔ SAE (agenda, minutas, diagramas y comentarios)', modules: ['E'], canApprove: ['Facturas', 'Notas de crédito', 'Pólizas'] });
+    await role('Sistemas', { description: 'Infraestructura del servidor de SAE, red, respaldos y accesos del conector', modules: ['CONFIG'] });
+    await role('Servicios al expositor', { description: 'Coordinación de solicitudes, pagos y autorizaciones de factura previa', modules: ['B'], canApprove: ['Factura antes del pago'] });
+
+    // 2. Quien crea: administrador, misma cuenta
+    const sources = await prisma.user.findMany({ where: { email, active: true, NOT: { tenantId: tid } }, orderBy: { createdAt: 'asc' } });
+    let me = await prisma.user.findUnique({ where: { tenantId_email: { tenantId: tid, email } } });
+    if (!me) {
+      if (!sources.length) throw new Error(`No hay un usuario activo con ${email} en otra organización.`);
+      const src = sources[0];
+      const acc = accountOf(src);
+      await prisma.user.updateMany({ where: { id: { in: sources.map((s) => s.id) }, accountId: null }, data: { accountId: acc } });
+      me = await prisma.user.create({ data: { tenantId: tid, email, name: src.name, title: src.title, accountId: acc, roleId: admin.id, channel: src.channel, passwordHash: src.passwordHash, googleSub: null, preferences: src.preferences ?? undefined } });
+      console.log(`${me.name} quedó como administrador de Expo Santa Fe (misma cuenta).`);
+    } else console.log(`${me.name} ya estaba en Expo Santa Fe.`);
+
+    // 3. Proyecto del Laboratorio
+    let board = await prisma.labBoard.findFirst({ where: { tenantId: tid, name: PROJECT, archived: false } });
+    if (!board) {
+      const code = await nextCode(tid, 'LAB', 3);
+      board = await prisma.labBoard.create({
+        data: {
+          tenantId: tid, code, name: PROJECT, shared: true, createdById: me.id, updatedById: me.id, ...FICHA,
+          data: { version: 1, name: PROJECT, items: [], connectors: [], roles: [], processes: {}, meetings: [], commitments: [] } as import('@theoffice/db').Prisma.InputJsonValue,
+          summary: { processes: 0, steps: 0, roles: 0, items: 0, refs: 0, published: 0 } as import('@theoffice/db').Prisma.InputJsonValue,
+        },
+      });
+      await logActivity(tid, { type: 'USER', id: me.id, name: me.name }, 'CONFIG', board.id, 'LAB_CREATED', `Creó el proyecto ${code} «${PROJECT}» en el Laboratorio`);
+      console.log(`Proyecto creado: ${code}.`);
+    } else console.log(`El proyecto ya existía (${board.code}).`);
+
+    const { board: canvas, done } = buildCanvas(await orgPeople(tid), board.data);
+    const { camera: _c, ...data } = canvas;
+    const wpData = !board.workplan || process.env.FORCE === '1' ? { workplan: buildWorkplan(me.name) as unknown as import('@theoffice/db').Prisma.InputJsonValue } : {};
+    await prisma.labBoard.update({ where: { id: board.id }, data: { data: data as unknown as import('@theoffice/db').Prisma.InputJsonValue, summary: summarize(data) as import('@theoffice/db').Prisma.InputJsonValue, updatedById: me.id, ...wpData } });
+    await prisma.comment.create({ data: { tenantId: tid, subjectType: 'LAB', subjectId: board.id, authorId: me.id, body: `Diagramó el ciclo de integración IventIA ↔ SAE: ${done.join('; ')}${'workplan' in wpData ? '; y la agenda de sesiones de integración' : ''}.` } });
+    console.log(`Lienzo: ${done.join('; ')}.`);
+    if ('workplan' in wpData) console.log('Agenda de sesiones puesta.'); else console.log('La agenda ya existía; no se tocó (FORCE=1 para reemplazarla).');
+    console.log(`Listo: /laboratorio/${board.id} en ${tenant.name}.`);
+    void Prisma;
+  } finally {
+    await prisma.$disconnect();
+  }
+}
+
+(process.env.DRY_RUN === '1' ? dryRun() : main()).catch((e) => { console.error((e as Error).message); process.exit(1); });

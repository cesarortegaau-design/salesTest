+name: Organización Expo Santa Fe (alta y proyecto de integración IventIA ↔ SAE)
+
+# Sólo manual: escribe en la base de producción. Crea la organización Expo Santa Fe con sus roles, da de alta a quien la
+# crea (administrador, misma cuenta) y crea en el Laboratorio el proyecto «Integración IventIA ↔ SAE: facturación
+# automática» con su lienzo (ecosistema, objetos espejo, procesos con historia de usuario) y la agenda de sesiones.
+# Idempotente; no borra nada. Requiere el secreto DATABASE_URL.
+on:
+  workflow_dispatch:
+    inputs:
+      correo:
+        description: 'Correo de quien crea la organización (su usuario en The Office)'
+        required: true
+        type: string
+      reemplazar_agenda:
+        description: 'Reemplazar la agenda si el proyecto ya tiene una'
+        required: false
+        type: boolean
+        default: false
+
+jobs:
+  expo-santa-fe:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: pnpm/action-setup@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 20
+          cache: pnpm
+      - run: pnpm install --frozen-lockfile
+      - name: Compilar el paquete de la base (cliente de Prisma y dist)
+        run: pnpm --filter @theoffice/db build
+      - name: Organización, proyecto, lienzo y agenda
+        working-directory: apps/api
+        run: npx --yes tsx@4.19.2 scripts/expo-santa-fe-organizacion.ts
+        env:
+          DATABASE_URL: ${{ secrets.DATABASE_URL }}
+          LAB_EMAIL: ${{ inputs.correo }}
+          FORCE: ${{ inputs.reemplazar_agenda && '1' || '' }}
